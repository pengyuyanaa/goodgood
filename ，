import pygame
import random

# 初始化Pygame
pygame.init()

# 游戏常量
SCREEN_WIDTH = 300
SCREEN_HEIGHT = 600
BLOCK_SIZE = 30
GRID_WIDTH = SCREEN_WIDTH // BLOCK_SIZE
GRID_HEIGHT = SCREEN_HEIGHT // BLOCK_SIZE

# 颜色定义
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
GRAY = (128, 128, 128)
COLORS = [
    (0, 255, 255),    # 青色
    (255, 165, 0),    # 橙色
    (0, 0, 255),      # 蓝色
    (255, 255, 0),    # 黄色
    (0, 255, 0),      # 绿色
    (128, 0, 128),    # 紫色
    (255, 0, 0)       # 红色
]

# 方块形状定义（每个形状由4个格子的坐标组成）
SHAPES = [
    [[1, 1, 1, 1]],  # I
    [[1, 1], [1, 1]],# O
    [[1, 1, 1], [0, 1, 0]],# T
    [[1, 1, 1], [1, 0, 0]],# L
    [[1, 1, 1], [0, 0, 1]],# J
    [[1, 1, 0], [0, 1, 1]],# S
    [[0, 1, 1], [1, 1, 0]] # Z
]

class Tetris:
    def __init__(self):
        self.screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
        pygame.display.set_caption("俄罗斯方块")
        self.clock = pygame.time.Clock()
        self.grid = [[BLACK for _ in range(GRID_WIDTH)] for _ in range(GRID_HEIGHT)]
        self.current_piece = self.new_piece()
        self.game_over = False
        self.score = 0

    # 生成新方块
    def new_piece(self):
        shape = random.choice(SHAPES)
        color = random.choice(COLORS)
        x = GRID_WIDTH // 2 - len(shape[0]) // 2
        y = 0
        return {"shape": shape, "color": color, "x": x, "y": y}

    # 绘制网格和方块
    def draw(self):
        self.screen.fill(BLACK)
        # 绘制当前方块
        for i, row in enumerate(self.current_piece["shape"]):
            for j, cell in enumerate(row):
                if cell:
                    x = (self.current_piece["x"] + j) * BLOCK_SIZE
                    y = (self.current_piece["y"] + i) * BLOCK_SIZE
                    pygame.draw.rect(self.screen, self.current_piece["color"], (x, y, BLOCK_SIZE-1, BLOCK_SIZE-1))
        # 绘制已放置的方块
        for y in range(GRID_HEIGHT):
            for x in range(GRID_WIDTH):
                if self.grid[y][x] != BLACK:
                    pygame.draw.rect(self.screen, self.grid[y][x], (x*BLOCK_SIZE, y*BLOCK_SIZE, BLOCK_SIZE-1, BLOCK_SIZE-1))
        # 绘制分数
        font = pygame.font.SysFont(None, 36)
        text = font.render(f"Score: {self.score}", True, WHITE)
        self.screen.blit(text, (10, 10))
        pygame.display.update()

    # 检测碰撞
    def check_collision(self, dx=0, dy=0, rotated_shape=None):
        shape = rotated_shape if rotated_shape else self.current_piece["shape"]
        for i, row in enumerate(shape):
            for j, cell in enumerate(row):
                if cell:
                    x = self.current_piece["x"] + j + dx
                    y = self.current_piece["y"] + i + dy
                    if x < 0 or x >= GRID_WIDTH or y >= GRID_HEIGHT:
                        return True
                    if y >= 0 and self.grid[y][x] != BLACK:
                        return True
        return False

    # 旋转方块
    def rotate_piece(self):
        rotated = list(zip(*reversed(self.current_piece["shape"])))
        if not self.check_collision(rotated_shape=rotated):
            self.current_piece["shape"] = rotated

    # 锁定方块到网格
    def lock_piece(self):
        for i, row in enumerate(self.current_piece["shape"]):
            for j, cell in enumerate(row):
                if cell:
                    x = self.current_piece["x"] + j
                    y = self.current_piece["y"] + i
                    if y < 0:
                        self.game_over = True
                        return
                    self.grid[y][x] = self.current_piece["color"]
        # 消除满行
        self.clear_lines()
        self.current_piece = self.new_piece()

    # 消除满行
    def clear_lines(self):
        lines_cleared = 0
        new_grid = []
        for row in self.grid:
            if BLACK not in row:
                lines_cleared += 1
            else:
                new_grid.append(row)
        # 补充空行
        for _ in range(lines_cleared):
            new_grid.insert(0, [BLACK for _ in range(GRID_WIDTH)])
        self.grid = new_grid
        self.score += lines_cleared * 100

